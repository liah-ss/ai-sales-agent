COMPOSE_PROJECT_NAME=examplecorp
BASE_REGISTRY=
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org/

# Primary application database.
DATABASE_URL=mysql+pymysql://app-user:url-encoded-password@mysql-host:3306/examplecorp?charset=utf8mb4
DATABASE_POOL_SIZE=24
DATABASE_MAX_OVERFLOW=8
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_AUTO_CREATE_SCHEMA=false

AUTH_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-admin-password
ACCESS_TOKEN_EXPIRE_MINUTES=480

FRONTEND_PORT=7200
MANAGEMENT_PORT=7201
BACKEND_PORT=7202
# Static generation runs with host networking. Linux resolves the host API here.
NUXT_API_INTERNAL_BASE=http://127.0.0.1:7202
CORS_ORIGINS=["https://example.com","https://www.example.com"]
VITE_ASSET_BASE_URL=https://assets.example.com
COS_UPLOAD_ENABLED=true
COS_BUCKET=replace-with-cos-bucket
COS_REGION=replace-with-cos-region
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key

# Optional speech transcription and realtime ASR.
SPEECH_TRANSCRIPTION_API_KEY=
SPEECH_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
SPEECH_TRANSCRIPTION_MODEL=whisper-1
DASHSCOPE_API_KEY=
DASHSCOPE_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
REALTIME_ASR_MODEL=fun-asr-realtime

# Content translation provider.
TRANSLATION_PROVIDER=openai-compatible
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.openai.com/v1
TRANSLATION_MODEL=gpt-4.1-mini
TRANSLATION_TIMEOUT_SECONDS=90

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=86400
REDIS_CACHE_NAMESPACE=examplecorp
PUBLIC_SITE_URL=https://example.com
NUXT_REVALIDATE_SECRET=replace-with-a-long-random-secret
NUXT_RUM_LOG_ENABLED=true

# HTTPS CRM webhook for newly stored inquiries. Empty keeps inquiries in the local admin only.
CRM_INQUIRY_WEBHOOK_URL=
CRM_INQUIRY_WEBHOOK_TOKEN=
CRM_INQUIRY_TIMEOUT_SECONDS=10
CRM_INQUIRY_RETRY_ATTEMPTS=3
CRM_INQUIRY_RETRY_DELAY_SECONDS=1
